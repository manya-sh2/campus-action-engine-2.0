# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/campus-action-engine

# Frontend (used for CORS and post-login redirects)
CLIENT_URL=http://localhost:3000

# --- Google OAuth (Phase 2) ---
# From Google Cloud Console > APIs & Services > Credentials
# (see README "Google Cloud Setup" section for step-by-step instructions)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# AES-256-GCM key used to encrypt stored Google tokens at rest.
# Must be a 64-character hex string (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Application session cookie (not Google's own tokens)
SESSION_COOKIE_NAME=cae_session
SESSION_TTL_DAYS=7

# Set to "true" to make Gmail/Classroom/Drive endpoints return canned
# sample data instead of calling real Google APIs - useful before you
# have Google Cloud credentials set up. Leave unset/false otherwise.
GOOGLE_MOCK_MODE=false

# --- OpenAI (Phase 3) ---
# From https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Any current model that supports Structured Outputs
# (response_format: json_schema). Check platform.openai.com/docs for the
# latest available model if gpt-4o-mini is no longer offered.
OPENAI_MODEL=gpt-4o-mini

# Set to "true" to use a small deterministic rule-based extractor instead
# of calling the real OpenAI API - useful before you have an OpenAI API
# key set up. Leave unset/false otherwise.
OPENAI_MOCK_MODE=false

# --- Realtime + Automation (Phase 4) ---
# Socket.IO reuses CLIENT_URL (CORS) and the same session cookie as the
# REST API - no separate config needed.
# MCP (mounted at /mcp) reuses the same session cookie auth too.

# Standard cron expression for the deadline-check job (node-cron syntax).
# Default: every 15 minutes.
DEADLINE_CRON_SCHEDULE=*/15 * * * *

# Set to "false" to disable the scheduled deadline job entirely.
ENABLE_DEADLINE_CRON=true
